#!/bin/bash
# /home/ubuntu/minecraft/backup.sh
# Terraform が terraform/templates/backup.sh.tftpl から生成している。
#
# 常駐プロセスを持たず、実行したい時だけコンテナを起動して終了後に破棄する。
# itzg/mc-backup が RCON 経由で save-off → save-all → バックアップ → save-on を
# 内部的に行うため、セーブ制御を自前で書く必要がない。
#
# 保存先は2段構成。
#   1. Cloudflare R2      … 別事業者への一次コピー
#   2. OCI Object Storage … 同一事業者内の二次コピー
set -euo pipefail

BACKUP_DIR=/home/ubuntu/minecraft/backups
KEEP_GENERATIONS=${keep_generations}
KEEP_R2_GENERATIONS=${r2_keep_generations}

# shellcheck disable=SC1091
source /home/ubuntu/minecraft/.env

log() { echo "[$(date -Is)] $*"; }

log "backup start"

# ---------- 0. mc が起動しているか ----------
# 下の --network container:mc は mc が停止していると
# 「network container:mc not found」という分かりにくいエラーで落ちる。
# mc_router_auto_scale = true で無人時に停止しているとき、
# および mc がクラッシュしているときに、先にここで理由を示して止まる。
if [ "$(docker inspect -f '{{.State.Running}}' mc 2>/dev/null)" != "true" ]; then
  log "mc コンテナが起動していないためバックアップできません"
  log "  cd /home/ubuntu/minecraft && docker compose up -d mc"
  exit 1
fi

# ---------- 1. ワールドのスナップショット ----------
# --network container:mc で mc コンテナのネットワーク名前空間を共有するため、
# bridge / host のどちらの exposure_mode でも localhost:25575 で RCON に届く。
docker run --rm \
  --network container:mc \
  -e RCON_HOST=localhost \
  -e RCON_PORT=25575 \
  -e RCON_PASSWORD="$${RCON_PASSWORD}" \
  -v /home/ubuntu/minecraft/data:/data:ro \
  -v "$${BACKUP_DIR}":/backups \
  itzg/mc-backup \
  backup now

log "snapshot done"

# ---------- 2. Cloudflare R2 へ ----------
# sync ではなく copy を使う。ローカルの世代削除が R2 側まで波及して
# 「手元のバグでクラウドのバックアップが消える」事故を防ぐため。
# R2 側の世代管理は下のブロックで行う。
rclone copy "$${BACKUP_DIR}" "r2:${r2_bucket}" --progress
log "uploaded to R2 (${r2_bucket})"
%{~ if r2_keep_generations > 0 }

# R2 の古い世代を削除。手動バックアップは実行頻度が一定しないため、
# 日数ではなく直近 N 世代で管理する (ローカルの世代整理と同じ考え方)。
rclone lsf "r2:${r2_bucket}" --files-only --format "tp" \
  | sort -r \
  | tail -n "+$((KEEP_R2_GENERATIONS + 1))" \
  | cut -d';' -f2- \
  | while read -r old; do
      log "removing R2 generation: $${old}"
      rclone deletefile "r2:${r2_bucket}/$${old}"
    done
rclone rmdirs "r2:${r2_bucket}" --leave-root || true
log "pruned R2 to last $${KEEP_R2_GENERATIONS} generations"
%{~ endif }
%{~ if enable_oci_backup }

# ---------- 3. OCI Object Storage へ ----------
# インスタンスプリンシパルで認証するため、VM 上に OCI の APIキーを置かない。
# 権限は iam.tf の dg-mc-server-instances + バケット限定ポリシー。
# 古い世代は storage.tf のライフサイクルポリシーが自動削除する。
# oci は uv tool install で /usr/local/bin に入れている。
oci os object bulk-upload \
  --auth instance_principal \
  --namespace "${oci_namespace}" \
  --bucket-name "${backup_bucket_name}" \
  --src-dir "$${BACKUP_DIR}" \
  --no-overwrite \
  --no-multipart
log "uploaded to OCI Object Storage (${backup_bucket_name})"
%{~ endif }

# ---------- 4. ローカルの世代整理 ----------
# 100GB のブートボリュームを埋めないように、手元は直近 N 世代だけ残す。
# クラウド側には既に転送済みなので、ここで消しても失われない。
if [ "$${KEEP_GENERATIONS}" -gt 0 ]; then
  find "$${BACKUP_DIR}" -maxdepth 1 -name '*.tgz' -printf '%T@ %p\n' \
    | sort -rn \
    | tail -n "+$((KEEP_GENERATIONS + 1))" \
    | cut -d' ' -f2- \
    | while read -r old; do
        log "removing local generation: $${old}"
        rm -f "$${old}"
      done
fi

log "backup done"
