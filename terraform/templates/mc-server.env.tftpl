# /home/ubuntu/minecraft/.env
# Terraform が生成している。手で書き換えても Ansible の app タグで上書きされる。
# サンプルと各項目の説明は env/mc-server.env_sample を参照。

# docker-compose.yml の RCON_PASSWORD と backup.sh の両方が参照する
RCON_PASSWORD=${rcon_password}

# playit エージェントが読む。空だとコンテナが exit 1 で即終了するため、
# playit.gg の docker 向けセットアップウィザードで先にキーを発行しておく
# (https://playit.gg/account/setup/wizard/new-account/docker/docker-name)。
# 取得した値を terraform.tfvars の playit_secret_key に入れ、
# terraform apply && ansible-playbook ... -t app で配送する。
PLAYIT_SECRET_KEY=${playit_secret_key}
