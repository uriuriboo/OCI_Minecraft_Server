# /home/ubuntu/.env
# Terraform が生成している。手で書き換えても Ansible の monitor タグで上書きされる。
# monitor.py が読む変数の一覧はこのファイルが唯一の正。
# サンプルと各項目の説明は env/mc-monitor.env_sample を参照。

DISCORD_WEBHOOK_URL=${discord_webhook_url}

# RCON は VCN 内のプライベートIPへ直結する (Tailscale を経由しない)
RCON_HOST=${rcon_host}
RCON_PORT=25575
RCON_PASSWORD=${rcon_password}

# Monitoring API のクエリ対象
ARM_INSTANCE_OCID=${arm_instance_ocid}
COMPARTMENT_OCID=${compartment_ocid}

# FilesystemUtilization の fileSystemName ディメンションの実測値。
# `/` ではなく `/dev/sda1` のようなデバイス名のことがある。
# 違っているとディスク使用率だけ取得できない (メトリクス・エクスプローラで確認)。
FILESYSTEM_NAME=${filesystem_name}

# アラート閾値。cpu/memory/disk は以上で発火、tps は未満で発火。
THRESHOLD_CPU=${threshold_cpu}
THRESHOLD_MEMORY=${threshold_memory}
THRESHOLD_DISK=${threshold_disk}
THRESHOLD_TPS=${threshold_tps}
