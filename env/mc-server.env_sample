# mc-server の /home/ubuntu/minecraft/.env のサンプル
#
# 実体は Terraform が terraform/templates/mc-server.env.tftpl から生成し、
# cloud-init で配置する。通常このファイルを手で使う必要はない。
# 参照用・手動フォールバック用。
#
# docker compose がこのファイルを自動で読み、docker-compose.yml 内の
# ${RCON_PASSWORD} / ${PLAYIT_SECRET_KEY} の変数展開に使う
# (docker compose がプロジェクトディレクトリの .env を自動で読む機能。
#  コンテナに直接渡す env_file 指定とは別)。

# openssl rand -base64 24
# docker-compose.yml の RCON_PASSWORD と backup.sh の両方が参照する
RCON_PASSWORD=generated-rcon-password

# playit エージェント用。exposure_mode = "playit" のときだけ意味を持つ。
#
# playit-agent のイメージは空の SECRET_KEY だと起動直後に exit 1 する。
# playit.gg の docker 向けセットアップウィザードで先にキーを発行し、
# ここに入れてから terraform.tfvars の playit_secret_key へ反映する。
# https://playit.gg/account/setup/wizard/new-account/docker/docker-name
PLAYIT_SECRET_KEY=
