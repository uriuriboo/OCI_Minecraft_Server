# mc-monitor の /home/ubuntu/.env のサンプル
#
# 実体は Terraform が terraform/templates/mc-monitor.env.tftpl から生成し、
# cloud-init で配置する。通常このファイルを手で使う必要はない。
#
# ここに置いてあるのは
#   - monitor.py が読む変数を一覧で確認するため
#   - Terraform を使わずに監視だけ別のホスト (自宅 Pi など) で動かす場合の雛形
# という2つの用途のため。
#
# 各値の入手元は docs/spec/08-parameters.md、生成元の対応は
# terraform/templates/mc-monitor.env.tftpl を参照。

# ---------- 必須 ----------

# Discord → チャンネル編集 → 連携サービス → ウェブフック
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# mc-server のプライベートIP。Tailscale を経由せず VCN 内で完結させる
RCON_HOST=10.0.1.10
RCON_PORT=25575
RCON_PASSWORD=generated-rcon-password

# terraform output minecraft_instance_ocid
ARM_INSTANCE_OCID=ocid1.instance.oc1..xxxxx
COMPARTMENT_OCID=ocid1.compartment.oc1..xxxxx

# ---------- 任意 (未設定ならコード側の既定値) ----------

# FilesystemUtilization の fileSystemName ディメンションの実測値。既定 "/"
# `/` ではなく `/dev/sda1` のようなデバイス名のことがある。
# 違っているとディスク使用率だけ取得できない。
FILESYSTEM_NAME=/

# アラート閾値。cpu/memory/disk は以上で発火、tps は未満で発火
THRESHOLD_CPU=85.0
THRESHOLD_MEMORY=85.0
THRESHOLD_DISK=80.0
THRESHOLD_TPS=15.0

# 前回の判定結果の保存先。既定 /home/ubuntu/monitor_state.json
# 常駐しないため、状態変化の検出にこのファイルを使う
STATE_FILE=/home/ubuntu/monitor_state.json

# カスタムメトリクスのネームスペース。既定 custom_minecraft
CUSTOM_NAMESPACE=custom_minecraft
